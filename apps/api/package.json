{
  "name": "@rhai/api",
  "version": "0.1.0",
  "private": true,
  "description": "RHAI ERP API: Express + TypeScript + Prisma (Phase 0/1: auth, sessions, roles, users)",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:email": "vitest run --config vitest.email.config.mts",
    "email:verify": "tsx scripts/email-verify.ts",
    "email:test": "tsx scripts/email-test.ts",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset:test": "tsx scripts/reset-test-db.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "5.22.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "exceljs": "4.4.0",
    "express": "4.21.2",
    "express-rate-limit": "8.6.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "^10.3.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.17.9",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "6.0.2",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.4.1",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.16.0",
    "vitest": "2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
