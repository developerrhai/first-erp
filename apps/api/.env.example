# Every variable the API reads. Copy to .env for local development (never commit .env).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rhai_erp
# At least 32 random bytes, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-bytes-of-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
SESSION_IDLE_MINUTES=30
# A rotated refresh token replayed within this many seconds is a tab race (409 REFRESH_RACE), not theft.
REFRESH_REUSE_GRACE_SECONDS=10
# CORS: exact allowed browser origins, comma-separated (scheme://host[:port], no path, no wildcard).
# CORS_ORIGINS and WEB_ORIGIN are accepted as aliases; values from all three are combined.
# Not needed when the browser reaches the API same-origin (Vite proxy, or Vercel rewrite -> Nginx).
WEB_ORIGINS=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Only honoured when NODE_ENV=test; the server refuses to start otherwise.
RATE_LIMIT_DISABLED=false
# Express `trust proxy`: loopback (default) trusts only a proxy on this machine, e.g. the Vite dev proxy.
# Use the proxy's address/subnet in production; never `true` behind an untrusted network.
TRUST_PROXY=loopback
# Max concurrent Argon2 operations; extra login/password requests get 503 SERVER_BUSY.
ARGON2_MAX_CONCURRENCY=8
# Optional outgoing email. Leave all settings unset to disable email delivery.
# One SMTP connection is shared; every department sender must be configured separately.
# The SMTP identity must be authorized by the provider to send as each configured address.
# SMTP_SECURE=true uses TLS immediately; false requires STARTTLS.
# Set SMTP_AUTH_METHOD=password for authenticated SMTP, or none only for an IT-approved relay.
# If SMTP_USER and SMTP_PASSWORD are supplied without SMTP_AUTH_METHOD, password auth is inferred.
# SMTP_USER and SMTP_PASSWORD must either both be set or both be omitted.
# Username/password SMTP AUTH is the only authenticated method implemented currently.
# Microsoft 365 may require OAuth 2.0; confirm tenant policy and auth method with IT first.
# Keep SMTP_PASSWORD secret; use your deployment's secret manager in production.
# SMTP_HOST=mail.example.invalid
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_AUTH_METHOD=password
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=replace-with-secret
# EMAIL_FROM_ADMINISTRATION=administration@example.invalid
# EMAIL_FROM_SALES=sales@example.invalid
# EMAIL_FROM_PURCHASE=purchase@example.invalid
# EMAIL_FROM_FINANCE=finance@example.invalid
# EMAIL_FROM_HR=hr@example.invalid
# EMAIL_FROM_PRODUCTION=production@example.invalid
# EMAIL_FROM_QUALITY=quality@example.invalid
# EMAIL_FROM_MAINTENANCE=maintenance@example.invalid
# EMAIL_FROM_WAREHOUSE=warehouse@example.invalid
# EMAIL_FROM_PROJECTS=projects@example.invalid
# EMAIL_FROM_SERVICE=service@example.invalid
# Used only by `npm run db:seed` to create the single Super Admin (wrap values containing # in quotes)
SUPERADMIN_LOGIN_ID=owner
SUPERADMIN_EMAIL=owner@rhai.local
SUPERADMIN_NAME=Owner
SUPERADMIN_PASSWORD='change-me-Str0ng!'
